# Server
PORT=4000
NODE_ENV=development

# Postgres (default for local + DigitalOcean)
DB_CLIENT=postgres
# Local Homebrew example:
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/glico_selfie
# DigitalOcean managed:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require

# Optional: set true only if you use a fully trusted CA chain
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Device / offline only — do not set these for Postgres:
# DB_CLIENT=sqlite
# SQLITE_PATH=./data/auth.db

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Superadmin account (seeded by npm run db:migrate)
SUPERADMIN_EMAIL=superadmin@glico.local
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_NAME=Super Admin
