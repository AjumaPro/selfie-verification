{
  "name": "selfie-verification-ui",
  "version": "2.0.0",
  "private": true,
  "description": "GLICO Life Platform — identity verification, meetings, and Ghana Card KYC",
  "author": "GLICO",
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "face-api.js": "^0.22.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.4.1",
    "react-icons": "^5.5.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "download-models": "node download-models.js",
    "package:download": "npm run build && node package-download.js",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "package:meetings-zip": "node ../Meetings-Device/frontend/scripts/package-meetings-zip.js",
    "electron:build:meetings": "node ../Meetings-Device/frontend/scripts/electron-build-meetings.js --mac --win",
    "electron:build": "node scripts/electron-build.js --mac --win",
    "electron:build:mac": "node scripts/electron-build.js --mac",
    "electron:build:win": "node scripts/electron-build.js --win"
  },
  "build": {
    "appId": "org.glico.selfie-verification",
    "productName": "GLICO Life Platform",
    "copyright": "Copyright \u00a9 GLICO",
    "extends": null,
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron/assets"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**",
      "!build/**/*.map",
      "!build/downloads/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./electron/afterPack.js",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Selfie-Verification-Mac-${version}.${ext}"
    },
    "dmg": {
      "title": "GLICO Life Platform",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Selfie-Verification-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GLICO Life Platform",
      "installerHeaderIcon": "electron/assets/icon.png",
      "deleteAppDataOnUninstall": false
    },
    "icon": "electron/assets/icon.png"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
