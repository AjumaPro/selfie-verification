# Copy to .env and fill in values. Never commit .env.

# Third-party KYC / selfie API
REACT_APP_API_BASE_URL=https://selfie.imsgh.org:2035/skyface
REACT_APP_DEFAULT_USER_ID=
REACT_APP_DEFAULT_MERCHANT_KEY=
REACT_APP_DEFAULT_CENTER=BRANCHLESS

# Auth API
# Local CRA: leave empty — craco proxies /api → http://127.0.0.1:4000
REACT_APP_AUTH_API_URL=

# Or point straight at the backend:
# REACT_APP_AUTH_API_URL=http://127.0.0.1:4000

# Production / DigitalOcean (UI + API same domain): leave empty or same-origin
# REACT_APP_AUTH_API_URL=
# REACT_APP_AUTH_API_URL=same-origin

# Copy to .env and fill in values. Never commit .env.

# Third-party KYC / selfie API
REACT_APP_API_BASE_URL=https://selfie.imsgh.org:2035/skyface
REACT_APP_DEFAULT_USER_ID=
REACT_APP_DEFAULT_MERCHANT_KEY=
REACT_APP_DEFAULT_CENTER=BRANCHLESS

# Auth API
# Local CRA: leave empty — craco proxies /api → http://127.0.0.1:4000
REACT_APP_AUTH_API_URL=

# Or point straight at the backend:
# REACT_APP_AUTH_API_URL=http://127.0.0.1:4000

# Production / DigitalOcean (UI + API same domain): leave empty or same-origin
# REACT_APP_AUTH_API_URL=
# REACT_APP_AUTH_API_URL=same-origin

# Mac / Windows Electron installers use file:// and cannot use empty same-origin.
# Set one of these before `npm run electron:build` to your live app URL:
# REACT_APP_AUTH_API_URL=https://your-app.ondigitalocean.app
# REACT_APP_DESKTOP_AUTH_API_URL=https://your-app.ondigitalocean.app

# Google Maps (Meetings place picker) — enable Places + Maps JavaScript + Geocoding
# in Google Cloud Console. Restrict the key by HTTP referrer.
# REACT_APP_GOOGLE_MAPS_API_KEY=your-key-here

# Show Admin tab on sign-in (false = hide; superadmin URL: ?admin=1)
REACT_APP_SHOW_SUPERADMIN_LOGIN=true
