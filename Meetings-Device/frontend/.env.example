# Auth / meetings API
# Dev: leave empty — craco proxies /api → http://127.0.0.1:4000
REACT_APP_AUTH_API_URL=

# Production host (must be HTTPS for install + GPS):
# REACT_APP_AUTH_API_URL=https://YOUR-APP.ondigitalocean.app

# Public site origin for guest QR / share links (required for Electron file:// builds)
# REACT_APP_PUBLIC_WEB_URL=https://YOUR-APP.ondigitalocean.app
# REACT_APP_DESKTOP_AUTH_API_URL=https://YOUR-APP.ondigitalocean.app

# Google Maps for accurate venue pins (Places + Maps JS + Geocoding APIs):
# REACT_APP_GOOGLE_MAPS_API_KEY=your-key-here
