*.dmg
*.exe
*.blockmap
*.app
**/public/downloads/*.zip
**/dist-desktop/**

# Logs and OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local DigitalOcean runtime spec (may contain DATABASE_URL)
.do/app.runtime.yaml

# IDE
.idea/
*.swp
*.swo
